# Copy to repository root as .env.ec2
# cp deploy/aws/env.ec2.sample .env.ec2

# Required
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGEME_generate_with_openssl_rand_hex_32
# Use at least 16 chars and change before first deploy.
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Recommended
FLASK_ENV=production
DATABASE_URL=sqlite:////app/data/septica.db
CORS_ORIGIN=https://your-domain.com
