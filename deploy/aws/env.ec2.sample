# Copy to repository root as .env.ec2
# cp deploy/aws/env.ec2.sample .env.ec2

# Required
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-random-hex-secret
# Use at least 16 chars and change before first deploy.
ADMIN_PASSWORD=change-me-too

# Recommended
FLASK_ENV=production
DATABASE_URL=sqlite:////app/data/septica.db
CORS_ORIGIN=https://your-domain.com
