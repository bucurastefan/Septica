# Copy this file to .env and fill in real values before running.
# Never commit .env to version control.

# ── Required in production ──────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-hex-string

# ── Optional overrides ──────────────────────────────────────────────────────
# Flask environment: 'production' or 'development' (default: development)
FLASK_ENV=production

# Database URL — defaults to SQLite at data/septica.db inside the container.
# Use a PostgreSQL URL for production with multiple workers:
#   DATABASE_URL=postgresql://user:password@host:5432/septica
DATABASE_URL=sqlite:////app/data/septica.db

# Restrict SocketIO WebSocket connections to your domain (recommended in production).
# Leave unset or '*' to allow all origins (fine for local development).
CORS_ORIGIN=https://yourdomain.com

# Admin panel password (used only when creating the admin user for the first time).
# Change this before the first run!
ADMIN_PASSWORD=change-me-too
